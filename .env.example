# Connection to this environment's Atlas database
MONGODB_URI=

# Signs the JWT in the session cookie
AUTH_SECRET=

# Base URL used in email links and WhatsApp text
APP_URL=

# ap-south-1
AWS_REGION=

# Key id for the app's IAM user (photo storage only)
AWS_ACCESS_KEY_ID=

# Secret for that key
AWS_SECRET_ACCESS_KEY=

# Private photo bucket for this environment
S3_BUCKET=

# Host that serves gallery images
CLOUDFRONT_DOMAIN=

# Resend sending API key (server-only)
RESEND_API_KEY=

# From-address on a domain verified in Resend
RESEND_FROM_ADDRESS=
