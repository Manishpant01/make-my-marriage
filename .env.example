# Connection to this environment's Atlas database
MONGODB_URI=

# Signs the JWT in the session cookie
AUTH_SECRET=

# Base URL used in email links and WhatsApp text
APP_URL=

# ap-south-1
AWS_REGION=

# Key id for the app's IAM user
AWS_ACCESS_KEY_ID=

# Secret for that key
AWS_SECRET_ACCESS_KEY=

# Private photo bucket for this environment
S3_BUCKET=

# Host that serves gallery images
CLOUDFRONT_DOMAIN=

# Verified from-address for invite, reminder, helper, and password mail
SES_FROM_ADDRESS=
